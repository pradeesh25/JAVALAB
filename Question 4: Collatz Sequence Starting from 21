public class CollatzSequence {
    public static void main(String[] args) {
        int n = 21;

        System.out.print("Sequence: " + n);

        while (n != 1) {
            if (n % 2 == 0) {
                n = n / 2;
            } else {
                n = 3 * n + 1;
            }
            System.out.print(" -> " + n);
        }
        System.out.println();
    }
}
