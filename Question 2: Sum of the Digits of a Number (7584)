public class SumOfDigits {
    public static void main(String[] args) {
        int number = 7584;
        int temp = number;
        int sum = 0;

        while (temp > 0) {
            int digit = temp % 10; // Extract the last digit
            sum += digit;          // Add to sum
            temp /= 10;            // Remove the last digit
        }

        System.out.println("Sum of digits of " + number + " is: " + sum);
    }
}
